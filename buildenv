PYTHON_XXHASH_VERSION="3.8.1"

###
### Build control file for the python-xxhash port
###

###
### Required Environment Variables
###
export ZOPEN_PROJECT_NAME="python-xxhash"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/ifduyue/python-xxhash.git"
# Follow the version variable rather than a literal, so the bump bot
# updating PYTHON_XXHASH_VERSION actually changes what gets built. A hardcoded
# tag drifts: the port then builds one version while reporting another.
export ZOPEN_STABLE_TAG="v${PYTHON_XXHASH_VERSION}"
export ZOPEN_STABLE_DEPS="check_python grep"
export ZOPEN_DEV_URL=""
export ZOPEN_DEV_DEPS="check_python grep"
export ZOPEN_CATEGORIES="development"
export ZOPEN_RUNTIME_DEPS="check_python"
# export ZOPEN_SYSTEM_PREREQ="zos25" # optional system pre-req (default=zos25)


